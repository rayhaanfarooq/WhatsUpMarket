ALPHA_VANTAGE_API_KEY=
DISCORD_WEBHOOK_URL=

# Supabase Postgres URI (Render + production).
# Project Settings → Database → Connect → "Session pooler" URI.
# Example:
# postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Discord thread IDs for each desk (enable Developer Mode → right-click thread → Copy ID).
# Webhook must live in the same parent channel as these threads.
# DISCORD_THREAD_TECH=
# DISCORD_THREAD_NUCLEAR=
# DISCORD_THREAD_HEALTHCARE=
# DISCORD_THREAD_FINANCE=
# DISCORD_THREAD_ENERGY=
# DISCORD_THREAD_INDUSTRIALS=
# DISCORD_THREAD_CONSUMER=
# Or one JSON map:
# DISCORD_THREAD_MAP={"tech":"123","nuclear":"456","healthcare":"789","finance":"101"}
